# Copy to .env.local for local development. Never commit real values.

# Realtime provider: "azure" (default) or "openai"
REALTIME_PROVIDER=azure

# Azure OpenAI (auth via DefaultAzureCredential: `az login` locally, Managed Identity in Azure; no API key)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_REALTIME_DEPLOYMENT=<deployment-name>

# OpenAI direct (only when REALTIME_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime

# Optional: YouTube transcript proxy for the deployed app (stored in Key Vault in Azure)
YOUTUBE_PROXY_URL=
