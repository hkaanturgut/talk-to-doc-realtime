# Copy to .env.local for local development. Never commit real values.
# Values for the Azure provider come from `azd env get-values` after `azd provision`.

# Realtime provider: "azure" (default) or "openai"
REALTIME_PROVIDER=azure

# Azure OpenAI in Foundry. Auth is DefaultAzureCredential (`az login` locally, Managed Identity in
# Azure). There is no API key; the app refuses to start if AZURE_OPENAI_API_KEY is set.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=gpt-4o-mini-transcribe

# OpenAI direct (only when REALTIME_PROVIDER=openai). Server-side only; Key Vault in Azure.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional: Supadata transcript API for YouTube captions in the hosted app (Key Vault in Azure).
SUPADATA_API_KEY=

# Optional: shared secret for the outbound-only caption relay (tools/caption-relay; Key Vault in Azure).
CAPTION_RELAY_SECRET=

# Optional: Application Insights (Entra auth; local auth is disabled on the resource).
APPLICATIONINSIGHTS_CONNECTION_STRING=
